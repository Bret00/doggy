<section class="closing-banner">
  <span class="eyebrow">{{ section.settings.eyebrow }}</span>
  <a href="{{ section.settings.link }}">{{ section.settings.text }}{% render 'icon', name: 'arrow-up-right' %}</a>
  {% render 'icon', name: 'paw-print', class: 'closing-paw', stroke_width: 1.3 %}
</section>

{% schema %}
{
  "name": "Closing banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEXT STOP: SOMEWHERE GOOD." },
    { "type": "text", "id": "text", "label": "Link text", "default": "Let’s go, buddy." },
    { "type": "url", "id": "link", "label": "Link", "default": "#shop" }
  ],
  "presets": [{ "name": "Closing banner" }]
}
{% endschema %}
