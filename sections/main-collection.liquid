<section class="collection-page">
  <header class="page-header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ collection.title | default: 'Shop' }}</h1>
    {%- if collection.description != blank -%}
      <p class="collection-intro">{{ collection.description | strip_html | truncatewords: 40 }}</p>
    {%- endif -%}
    <div class="page-rule" aria-hidden="true"></div>
  </header>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', card_product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="collection-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="collection-empty">
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow above the title", "default": "EVERYTHING FOR THE BACK SEAT" },
    { "type": "text", "id": "empty_text", "label": "Text when the collection is empty", "default": "Nothing here yet." }
  ]
}
{% endschema %}
