<section class="faq-section section-pad" id="{{ section.settings.anchor_id }}">
  <div data-reveal>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% render 'icon', name: 'paw-print', size: 100, stroke_width: 1.2, class: 'faq-paw' %}
  </div>
  <div class="faq-list">
    {%- for block in section.blocks -%}
      <details class="accordion-item" name="faq-group" {{ block.shopify_attributes }}>
        <summary data-slot="accordion-trigger"><span><span class="faq-number">0{{ forloop.index }}</span>{{ block.settings.question }}</span>{% render 'icon', name: 'chevron-down', size: 16 %}</summary>
        <div data-slot="accordion-content">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "questions" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMON QUESTIONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "The things people ask before ordering." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it fit my car?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "Will it fit my car?", "answer": "<p>Fits most SUVs, trucks with a back bench, and larger crossovers and wagons. Standard sedans work with a shorter platform section. Not for compact two-doors. Email us your year, make and model if you are unsure.</p>" } },
      { "type": "faq", "settings": { "question": "Will my dog feel boxed in?", "answer": "<p>No. Mesh side windows keep it open — your dog sees out and gets airflow, and you can see your dog.</p>" } },
      { "type": "faq", "settings": { "question": "How do I clean it?", "answer": "<p>Unclip it, shake it out, then wipe or hose it down and let it air dry. Machine washable cold when it needs a proper clean.</p>" } },
      { "type": "faq", "settings": { "question": "How long is shipping?", "answer": "<p>Most orders ship within 2 business days. Delivery is usually 1–2 weeks across Canada and the US, with tracking.</p>" } },
      { "type": "faq", "settings": { "question": "Is it a crash restraint?", "answer": "<p>No. It protects your seats and gives your dog a flat surface to lie on. It is not crash-tested. Use a proper harness or crate if you want crash protection.</p>" } },
      { "type": "faq", "settings": { "question": "What if it doesn’t work out?", "answer": "<p>Send it back within 30 days of delivery for a full refund. It can show honest use, but it needs to be clean and dry.</p>" } }
    ]
  },
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
