<section class="faq-section section-pad" id="{{ section.settings.anchor_id }}">
  <div data-reveal>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% render 'icon', name: 'paw-print', size: 100, stroke_width: 1.2, class: 'faq-paw' %}
  </div>
  <div class="faq-list">
    {%- for block in section.blocks -%}
      <details class="accordion-item" name="faq-group" {{ block.shopify_attributes }}>
        <summary data-slot="accordion-trigger"><span><span class="faq-number">0{{ forloop.index }}</span>{{ block.settings.question }}</span>{% render 'icon', name: 'chevron-down', size: 16 %}</summary>
        <div data-slot="accordion-content">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "questions" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A FEW GOOD ANSWERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Everything to know before you hit the road." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it fit my car?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "faq", "settings": { "question": "Will it fit my car?", "answer": "<p>The platform measures 52 × 25 inches (approximately 132 × 64 cm). Compatible with most cars, SUVs, and small trucks. Measure your backseat before ordering; a universal fit is not guaranteed.</p>" } },
      { "type": "faq", "settings": { "question": "Is it suitable for a large dog?", "answer": "<p>The hard-bottom platform is rated to support up to 400 lb. Check that your dog has enough room in your vehicle. This weight rating describes platform support, not crash protection.</p>" } },
      { "type": "faq", "settings": { "question": "How do I clean it?", "answer": "<p>The PU leather surface wipes clean. Remove loose fur and dirt, then wipe with a damp cloth. Do not machine-wash the rigid support panels.</p>" } },
      { "type": "faq", "settings": { "question": "Can a passenger still sit in the back?", "answer": "<p>The foldable design allows part of the extender to fold so one or two passengers can use the remaining seat space, depending on your vehicle. Keep seat belts and buckles accessible.</p>" } },
      { "type": "faq", "settings": { "question": "What comes with it?", "answer": "<p>The backseat extender, a dog safety belt, and a storage bag.</p>" } },
      { "type": "faq", "settings": { "question": "What's your shipping & returns policy?", "answer": "<p>See our Shipping and Returns pages for current delivery times and return terms.</p>" } }
    ]
  },
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
