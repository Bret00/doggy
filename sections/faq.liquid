<section class="faq-section section-pad" id="{{ section.settings.anchor_id }}">
  <div data-reveal>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>
    {% render 'icon', name: 'paw-print', size: 100, stroke_width: 1.2, class: 'faq-paw' %}
  </div>
  <div class="faq-list">
    {%- for block in section.blocks -%}
      <details class="accordion-item" name="faq-group" {{ block.shopify_attributes }}>
        <summary data-slot="accordion-trigger"><span><span class="faq-number">0{{ forloop.index }}</span>{{ block.settings.question }}</span>{% render 'icon', name: 'chevron-down', size: 16 %}</summary>
        <div data-slot="accordion-content">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "questions"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMMON QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common questions."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "The things people ask before ordering."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will it fit my car?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
