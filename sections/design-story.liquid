<section class="design-story" id="{{ section.settings.anchor_id }}" data-story aria-label="Explore the flat-bed platform design">
  <div class="story-sticky">
    <div class="story-header">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <span class="story-counter" data-story-counter>01 <span>/ 0{{ section.blocks.size }}</span></span>
    </div>
    <div class="story-stage">
      <div class="story-copy" aria-live="off" data-story-copy>
        {%- for block in section.blocks -%}
          <div class="story-chapter{% if forloop.first %} active{% endif %}" aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}" {{ block.shopify_attributes }}>
            <span class="story-eyebrow">{{ block.settings.eyebrow }}</span>
            <h2><span>{{ block.settings.heading_line1 }}<br></span><span class="accent-text">{{ block.settings.heading_line2 }}<br></span></h2>
            <p>{{ block.settings.body }}</p>
            <div class="story-detail">{% render 'icon', name: block.settings.icon, size: 18 %}{{ block.settings.detail_text }}</div>
          </div>
        {%- endfor -%}
      </div>
      <div class="story-model">
        <div class="technical-grid" aria-hidden="true"></div>
        {%- render 'product-scene', mode: 'story', fallback_image: section.settings.product.featured_image -%}
        <span class="model-caption" data-story-caption>{{ section.blocks.first.settings.caption }}</span>
        <span class="model-disclaimer">3D product illustration</span>
      </div>
    </div>
    <div class="chapter-tabs" aria-label="Design chapters" data-story-tabs>
      {%- for block in section.blocks -%}
        <button type="button" data-story-tab="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}" aria-current="{% if forloop.first %}step{% endif %}"><span>0{{ forloop.index }}</span>{{ block.settings.tab_label }}<span class="tab-track"></span></button>
      {%- endfor -%}
    </div>
    <div class="story-progress" aria-hidden="true" data-story-progress></div>
  </div>
</section>

{% schema %}
{
  "name": "Design story",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "design"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (for 3D view fallback image)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILT AROUND YOUR DOG’S BODY"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Flat, not a slope"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "FILLS THE FOOTWELL"
        },
        {
          "type": "text",
          "id": "heading_line1",
          "label": "Heading line 1",
          "default": "Flat,"
        },
        {
          "type": "text",
          "id": "heading_line2",
          "label": "Heading line 2 (accent)",
          "default": "not a slope."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Fills the footwell so your dog lies down properly instead of bracing against a gap."
        },
        {
          "type": "text",
          "id": "detail_text",
          "label": "Detail text",
          "default": "Wall to wall, door to door"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "maximize-2",
          "options": [
            {
              "value": "maximize-2",
              "label": "Maximize"
            },
            {
              "value": "layers-3",
              "label": "Layers"
            },
            {
              "value": "droplets",
              "label": "Droplets"
            },
            {
              "value": "wind",
              "label": "Wind"
            }
          ]
        },
        {
          "type": "text",
          "id": "caption",
          "label": "3D view caption",
          "default": "ONE LEVEL SURFACE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Design story"
    }
  ]
}
{% endschema %}
