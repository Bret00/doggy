<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow"><span class="tiny-cross">+</span> {{ section.settings.eyebrow }}</div>
    <h1 id="hero-title">{{ section.settings.heading_line1 }}<br><span>{{ section.settings.heading_line2 }}</span></h1>
    <p>{{ section.settings.subtext }}</p>
    <div class="hero-ctas">
      <a class="pill-button dark-button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }} {% render 'icon', name: 'arrow-up-right', size: 19 %}</a>
      <a class="text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_text }} {% render 'icon', name: 'arrow-down', size: 16 %}</a>
    </div>
    <div class="hero-note">{% render 'icon', name: 'paw-print', size: 19 %}<span>{{ section.settings.note_text }}</span></div>
  </div>

  <div class="hero-product">
    <span class="product-index">{{ section.settings.product_index }}</span>
    <div class="hero-halo" aria-hidden="true"></div>
    {%- render 'product-scene', mode: 'hero', fallback_image: section.settings.product.featured_image -%}
    <div class="floating-label label-one"><span class="label-dot"></span> {{ section.settings.floating_label }}</div>
    <div class="product-interaction">
      <span>{% render 'icon', name: 'rotate-ccw', size: 14 %} Drag to take a look</span>
      <button type="button" data-scene-reset aria-label="Reset product rotation">{% render 'icon', name: 'rotate-ccw', size: 18 %}</button>
    </div>
    <span class="hero-coordinate">{{ section.settings.side_label }}</span>
  </div>

  <a class="scroll-cue" href="{{ section.settings.secondary_link }}"><span>SCROLL TO GET TO KNOW IT</span>{% render 'icon', name: 'arrow-down', size: 18 %}</a>
  <div class="hero-bottom">{{ section.settings.bottom_line1 }}<br><span>{{ section.settings.bottom_line2 }}</span></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (for 3D view fallback image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FOR YOUR FAVOURITE PASSENGER" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "For your" },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2 (accent)", "default": "ride or die." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "A little more room. A lot more adventure. Give your best friend the backseat they deserve." },
    { "type": "text", "id": "cta_text", "label": "Primary button text", "default": "Meet their new seat" },
    { "type": "url", "id": "cta_link", "label": "Primary button link", "default": "#shop" },
    { "type": "text", "id": "secondary_text", "label": "Secondary link text", "default": "Explore the design" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "default": "#design" },
    { "type": "text", "id": "note_text", "label": "Note text", "default": "Big stretches. Muddy paws. All welcome." },
    { "type": "text", "id": "product_index", "label": "Product index label", "default": "NO. 01 / THE FLAT-BED PLATFORM" },
    { "type": "text", "id": "floating_label", "label": "Floating label", "default": "A SOLID SEAT FOR EVERY ADVENTURE" },
    { "type": "text", "id": "side_label", "label": "Vertical side label", "default": "ROADNEST STARTS HERE." },
    { "type": "text", "id": "bottom_line1", "label": "Bottom line 1", "default": "A BETTER BACKSEAT." },
    { "type": "text", "id": "bottom_line2", "label": "Bottom line 2", "default": "A BETTER WAY TO GO." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
