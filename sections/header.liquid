<header class="site-header">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">{{ section.settings.logo_text }}<span class="brand-dot">.</span></a>

  <nav class="desktop-nav" aria-label="Main navigation">
    {%- for link in section.settings.main_menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="header-actions">
    <a href="{{ section.settings.shop_link }}" class="nav-shop">{{ section.settings.shop_link_text }} {% render 'icon', name: 'arrow-up-right', size: 16 %}</a>
    <button type="button" class="bag-button" data-cart-toggle aria-haspopup="dialog" aria-controls="CartDrawer" aria-label="Open bag, {{ cart.item_count }} items">
      {% render 'icon', name: 'shopping-bag', size: 20 %}<span>Bag (<span data-cart-count>{{ cart.item_count }}</span>)</span>
    </button>
    <button type="button" class="mobile-menu" data-nav-toggle aria-haspopup="dialog" aria-controls="MobileNav" aria-label="Open navigation">
      {% render 'icon', name: 'menu', size: 23 %}
    </button>
  </div>
</header>

{% render 'cart-drawer' %}
{% render 'mobile-nav', menu: section.settings.main_menu, shop_link: section.settings.shop_link, shop_link_text: section.settings.shop_link_text %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "good miles" },
    { "type": "link_list", "id": "main_menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "url", "id": "shop_link", "label": "\"Shop\" link", "default": "#shop" },
    { "type": "text", "id": "shop_link_text", "label": "\"Shop\" link text", "default": "Shop the extender" }
  ]
}
{% endschema %}
