<header class="site-header">
  <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
    {%- if section.settings.show_logo_mark -%}
      <img class="wordmark-mark" src="{{ 'roadnest-mark.svg' | asset_url }}" alt="" width="38" height="38" loading="eager">
    {%- endif -%}
    <span class="wordmark-text">{{ section.settings.logo_text }}<span class="brand-dot">.</span></span>
  </a>

  <nav class="desktop-nav" aria-label="Main navigation">
    {%- for link in section.settings.main_menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="header-actions">
    {%- comment -%}
      A real search form posting to /search, so it still works with JS off. The input is
      collapsed to an icon until opened, which keeps the header from getting crowded next
      to the nav.
    {%- endcomment -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="header-search" data-search-form>
      <input type="hidden" name="type" value="product">
      <label class="visually-hidden" for="HeaderSearch">Search products</label>
      <input type="search" id="HeaderSearch" name="q" placeholder="Search" autocomplete="off" value="{{ search.terms | escape }}" data-search-input>
      <button type="submit" class="header-search-submit" aria-label="Search">{% render 'icon', name: 'search', size: 19 %}</button>
      <button type="button" class="header-search-close" aria-label="Close search" data-search-close>{% render 'icon', name: 'x', size: 18 %}</button>
    </form>
    <button type="button" class="header-search-open" aria-label="Open search" aria-expanded="false" data-search-open>{% render 'icon', name: 'search', size: 20 %}</button>
    <a href="{{ section.settings.shop_link }}" class="nav-shop">{{ section.settings.shop_link_text }} {% render 'icon', name: 'arrow-up-right', size: 16 %}</a>
    <button type="button" class="bag-button" data-cart-toggle aria-haspopup="dialog" aria-controls="CartDrawer" aria-label="Open bag, {{ cart.item_count }} items">
      {% render 'icon', name: 'shopping-bag', size: 20 %}<span>Bag (<span data-cart-count>{{ cart.item_count }}</span>)</span>
    </button>
    <button type="button" class="mobile-menu" data-nav-toggle aria-haspopup="dialog" aria-controls="MobileNav" aria-label="Open navigation">
      {% render 'icon', name: 'menu', size: 23 %}
    </button>
  </div>
</header>

{% render 'cart-drawer' %}
{% render 'mobile-nav', menu: section.settings.main_menu, shop_link: section.settings.shop_link, shop_link_text: section.settings.shop_link_text %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "RoadNest"
    },
    {
      "type": "checkbox",
      "id": "show_logo_mark",
      "label": "Show logo mark beside the name",
      "default": true
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "shop_link",
      "label": "\"Shop\" link",
      "default": "/collections/shop-all"
    },
    {
      "type": "text",
      "id": "shop_link_text",
      "label": "\"Shop\" link text",
      "default": "Shop the platform"
    }
  ]
}
{% endschema %}
