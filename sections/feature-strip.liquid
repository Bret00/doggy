<section class="feature-strip" aria-label="Product highlights">
  {%- for block in section.blocks -%}
    <div {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.label }}</span></div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Feature strip",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "layers-3",
          "options": [
            {
              "value": "layers-3",
              "label": "Layers"
            },
            {
              "value": "droplets",
              "label": "Droplets"
            },
            {
              "value": "maximize-2",
              "label": "Maximize"
            },
            {
              "value": "wind",
              "label": "Wind"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "paw-print",
              "label": "Paw print"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature strip"
    }
  ]
}
{% endschema %}
