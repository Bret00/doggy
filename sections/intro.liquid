<section class="intro section-pad" data-reveal id="{{ section.settings.anchor_id }}">
  <div class="eyebrow">{{ section.settings.eyebrow }}</div>
  <h2>{{ section.settings.heading_line1 }}<br><span>{{ section.settings.heading_line2 }}</span></h2>
  <p>{{ section.settings.body }}</p>
</section>

{% schema %}
{
  "name": "Intro",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID (for nav links)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILT AROUND YOUR DOG'S BODY"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "A normal cover just drapes over the bench."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (muted)",
      "default": "Your dog still slides into the footwell."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "RoadNest drops a padded panel into that gap and turns the whole back seat into one flat bed."
    }
  ],
  "presets": [
    {
      "name": "Intro"
    }
  ]
}
{% endschema %}
