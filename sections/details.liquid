<section class="details-section section-pad">
  <div class="details-heading" data-reveal>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading_line1 }}<br>{{ section.settings.heading_line2 }}</h2>
  </div>
  <div class="detail-list">
    {%- for block in section.blocks -%}
      <div class="detail-row" data-reveal {{ block.shopify_attributes }}>
        <span class="detail-number">0{{ forloop.index }}</span>
        <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        {% render 'icon', name: block.settings.icon, size: 26 %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Details",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT YOU SHOULD KNOW"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Before you"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "order."
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Will it fit your car?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Fits most SUVs, trucks with a back bench, and larger crossovers and wagons."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "layers-3",
          "options": [
            {
              "value": "layers-3",
              "label": "Layers"
            },
            {
              "value": "droplets",
              "label": "Droplets"
            },
            {
              "value": "maximize-2",
              "label": "Maximize"
            },
            {
              "value": "wind",
              "label": "Wind"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Details"
    }
  ]
}
{% endschema %}
