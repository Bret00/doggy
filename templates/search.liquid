{%- comment -%}
  Search results. Uses the same product card as the Shop page so a result looks like a
  product — price, blurb, quick add — rather than a bare thumbnail people have to click
  through to price up.

  Results can include pages and articles as well as products, so non-products render as a
  plain text result instead of being forced into a product card.
{%- endcomment -%}
<section class="collection-page">
  <header class="page-header">
    <span class="eyebrow">SEARCH</span>
    <h1>
      {%- if search.performed -%}
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}
      {%- else -%}
        Search
      {%- endif -%}
    </h1>
    {%- if search.performed and search.terms != blank -%}
      <p class="collection-intro">for &ldquo;{{ search.terms }}&rdquo;</p>
    {%- endif -%}
    <div class="page-rule" aria-hidden="true"></div>
  </header>

  <div class="search-page-form">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <label class="visually-hidden" for="SearchPageInput">Search products</label>
      <input type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="Search products" autocomplete="off">
      <button type="submit" class="pill-button dark-button">Search {% render 'icon', name: 'arrow-right', size: 17 %}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        {%- assign product_results = 0 -%}
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{%- assign product_results = product_results | plus: 1 -%}{%- endif -%}
        {%- endfor -%}

        {%- if product_results > 0 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- render 'product-card', card_product: item -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign other_results = search.results_count | minus: product_results -%}
        {%- if other_results > 0 -%}
          <div class="search-other">
            <h2>Pages</h2>
            <ul>
              {%- for item in search.results -%}
                {%- unless item.object_type == 'product' -%}
                  <li>
                    <a href="{{ item.url }}">{{ item.title }}</a>
                    {%- if item.content != blank -%}
                      <p>{{ item.content | strip_html | truncatewords: 24 }}</p>
                    {%- endif -%}
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="collection-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

      {% render 'trust-strip' %}
    {%- else -%}
      {%- comment -%}
        A dead end is where people leave. Give them the way back to the full catalogue
        rather than an apology on its own.
      {%- endcomment -%}
      <div class="search-empty">
        <p>Nothing matched &ldquo;{{ search.terms }}&rdquo;.</p>
        <p class="search-empty-hint">Try a shorter word &mdash; &ldquo;cover&rdquo;, &ldquo;seat&rdquo;, &ldquo;bottle&rdquo; &mdash; or browse everything.</p>
        <a class="pill-button dark-button" href="{{ routes.collections_url }}/shop-all">See all products {% render 'icon', name: 'arrow-right', size: 17 %}</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>
