<div class="section-pad simple-page" style="text-align:center">
  <a class="wordmark" href="{{ routes.root_url }}" style="justify-content:center;display:flex">{{ shop.name }}<span class="brand-dot">.</span></a>
  <p style="margin:24px 0;color:#6a6152">{{ shop.password_message }}</p>
  {%- form 'storefront_password' -%}
    <input type="password" name="password" placeholder="Enter store password" aria-label="Password">
    <button type="submit" class="pill-button dark-button" style="margin-top:14px">Enter {% render 'icon', name: 'arrow-right', size: 17 %}</button>
    {%- if form.errors -%}<p style="color:var(--destructive);margin-top:14px">{{ form.errors.messages['form'] }}</p>{%- endif -%}
  {%- endform -%}
</div>
