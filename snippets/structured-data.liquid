{%- comment -%}
  JSON-LD for search engines. This is what lets Google show price, availability and
  (eventually) stars under the listing instead of a plain blue link.

  Deliberately omits aggregateRating. The store has no reviews yet, and emitting a rating
  block with zero reviews is both a Google structured-data violation and a lie about the
  product. It appears on its own once the reviews metafield exists.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name

  # The sitelinks-search target has to carry a literal {search_term_string} placeholder.
  # Written inline in an output tag, Liquid's parser hits the brace and never finds the
  # closing }}, and Shopify rejects the whole file — silently, on a GitHub sync. Built as
  # an assign instead, where braces inside a quoted string are not special.
  assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
-%}

{%- if template.name == 'product' and product != blank -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- comment -%}
      Loop images, not media. product.media includes the video, and skipping it inside the
      loop left a trailing comma whenever the video was the last item -- which it is on the
      flagship -- producing invalid JSON that Google discards wholesale. product.images
      contains only images, so forloop.last is trustworthy.
    {%- endcomment -%}
    {%- if product.images.size > 0 -%}
    "image": [
      {%- for image in product.images limit: 5 -%}
        {{ image | image_url: width: 1200 | prepend: "https:" | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif -%}
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- if variant.sku != blank -%}
    "sku": {{ variant.sku | json }},
    {%- endif -%}
    {%- assign rating = product.metafields.reviews.rating.value -%}
    {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
    {%- if rating != blank and rating_count > 0 -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "bestRating": {{ rating.scale_max | json }},
      "ratingCount": {{ rating_count | json }}
    },
    {%- endif -%}
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }
  }
  </script>
{%- endif -%}

{%- if template.name == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    "logo": {{ 'roadnest-mark.svg' | asset_url | prepend: request.origin | json }}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- comment -%} Open Graph, so a link pasted into a message or an ad preview isn't bare. {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
{%- if template.name == 'product' and product.featured_media.preview_image -%}
  <meta property="og:image" content="https:{{ product.featured_media.preview_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- else -%}
  <meta property="og:image" content="{{ 'lifestyle.webp' | asset_url | prepend: request.origin }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
