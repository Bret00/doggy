    <path d="M13 5H19V11"/><path d="M19 5L5 19"/>
  {%- when 'chevron-down' -%}
    <path d="m6 9 6 6 6-6"/>
  {%- when 'play' -%}
    <path d="M6 4.5v15l13-7.5z" fill="currentColor" stroke="none"/>
