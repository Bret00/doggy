{%- comment -%}
  Renders a Lucide-style icon. Usage: {% render 'icon', name: 'arrow-up-right', size: 18 %}
  Paths ported from lucide-react (ISC license) to avoid a JS icon-font dependency.
{%- endcomment -%}
{%- liquid
  assign size = size | default: 24
  assign stroke_width = stroke_width | default: 2
-%}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke_width }}" stroke-linecap="round" stroke-linejoin="round" class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'arrow-up-right' -%}
    <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
  {%- when 'arrow-down' -%}
    <path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>
  {%- when 'arrow-right' -%}
    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
  {%- when 'check' -%}
    <path d="M20 6 9 17l-5-5"/>
  {%- when 'chevron-left' -%}
    <path d="m15 18-6-6 6-6"/>
  {%- when 'chevron-right' -%}
    <path d="m9 18 6-6-6-6"/>
  {%- when 'droplets' -%}
